<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E6395B8" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#B8E8F7FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2C6A9CC2" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#7898C9E8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#222E3D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
