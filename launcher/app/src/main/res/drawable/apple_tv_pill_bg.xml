<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#526F91AA" android:endColor="#304C6A85" />
            <stroke android:width="1dp" android:color="#B8EAF8FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#50FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
